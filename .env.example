JIRA_COOKIE_SECRET=changez-moi-en-production

# Connexion Jira (sinon via l'UI) — défauts alignés n8n Coverseal
JIRA_BASE_URL=https://coverseal.atlassian.net
JIRA_EMAIL=it@coverseal.com
JIRA_API_TOKEN=
JIRA_JQL_BASE=project = CSD
JIRA_OPEN_STATUS_JQL=status NOT IN (Partenaire, Canceled, Done)
JIRA_DATE_PRISE_EN_CHARGE_JQL=Date Prise en Charge
JIRA_DATE_PRISE_EN_CHARGE_FIELD=customfield_10284
JIRA_SLA_PRISE_EN_CHARGE_HOURS=24
JIRA_SLA_CLOTURE_HOURS=48
JIRA_CATEGORY_FIELD=component

# SMTP (serveur mail existant Coverseal) — rapport KPI hebdo
SMTP_HOST=smtp.coverseal.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="KPI IT <noreply@coverseal.com>"
SMTP_TO=it@coverseal.com
# Optionnel : protège /api/mail/cron (Authorization: Bearer …)
CRON_SECRET=
