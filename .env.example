JIRA_COOKIE_SECRET=changez-moi-en-production
# Sert aussi à chiffrer email+token / OAuth stockés dans Supabase (même secret sur tous les déploiements).

# Connexion Jira (sinon via l'UI) — défauts alignés n8n Coverseal
JIRA_BASE_URL=https://coverseal.atlassian.net
JIRA_EMAIL=it@coverseal.com
JIRA_API_TOKEN=
JIRA_JQL_BASE=project = CSD
JIRA_OPEN_STATUS_JQL=status NOT IN (Partenaire, Canceled, Done)
JIRA_DATE_PRISE_EN_CHARGE_JQL=Date Prise en Charge
JIRA_DATE_PRISE_EN_CHARGE_FIELD=customfield_10284
JIRA_SLA_PRISE_EN_CHARGE_HOURS=24
JIRA_SLA_CLOTURE_HOURS=48
# Champ Jira « Catégorie » Coverseal = customfield_10152
JIRA_CATEGORY_FIELD=custom
JIRA_CATEGORY_CUSTOM_FIELD=customfield_10152

# OAuth 2.0 (3LO) Atlassian — connexion Microsoft SSO via l’écran Atlassian
# Créer une app : https://developer.atlassian.com/console/myapps/
# Scopes : read:jira-work write:jira-work read:jira-user offline_access
# Callback URL : https://VOTRE_DOMAINE/api/jira/oauth/callback
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
# Optionnel si différent de l’origine du site
# ATLASSIAN_REDIRECT_URI=https://votre-app.vercel.app/api/jira/oauth/callback

# Cron figement « non résolus » (dimanche 23:59 Bruxelles)
CRON_SECRET=

# Supabase — source de vérité durable (recommandé en prod)
# Projet : https://supabase.com/dashboard/project/octsjgehlfjxdrzfkoya
# Tables : kpi_app_state (KPI) + kpi_jira_connection (credentials chiffrés)
SUPABASE_URL=https://octsjgehlfjxdrzfkoya.supabase.co
# Clé service_role (Settings → API) — serveur uniquement, jamais NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Secours optionnel Vercel Blob (si Supabase non configuré)
# BLOB_READ_WRITE_TOKEN=
